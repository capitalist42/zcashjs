{
  "name": "@zcash-js/wasm",
  "version": "0.1.0",
  "description": "Rust/Wasm cryptographic boundary for zcash-js",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "generated"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "wasm-pack build crate --target web --out-dir ../generated --release",
    "clean": "rm -rf dist generated crate/target",
    "test": "vitest run && cargo test --manifest-path crate/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@zcash-js/core": "0.1.0" },
  "devDependencies": { "typescript": "^5.9.0", "vitest": "^3.2.0" }
}
