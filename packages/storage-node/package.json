{
  "name": "@zcash-js/storage-node",
  "version": "0.2.0",
  "description": "Node SQLite storage adapter for zcash-js",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
