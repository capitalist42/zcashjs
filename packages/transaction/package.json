{
  "name": "@zcash-js/transaction",
  "version": "0.1.0",
  "description": "Safe structural inspection for serialized Zcash transactions",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
