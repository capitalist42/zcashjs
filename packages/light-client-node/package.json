{
  "name": "@zcash-js/light-client-node",
  "version": "0.6.0",
  "description": "Node HTTP/2 gRPC transport for the canonical Zcash light wallet protocol",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "proto"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=22" },
  "scripts": { "build": "tsc -p tsconfig.json", "clean": "rm -rf dist", "test": "vitest run", "test:live": "vitest run --config vitest.live.config.ts", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "dependencies": { "@grpc/grpc-js": "^1.14.0", "@grpc/proto-loader": "^0.8.0", "@zcash-js/core": "0.1.0", "@zcash-js/light-client": "0.2.0", "protobufjs": "^7.5.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0", "vitest": "^3.2.0" }
}
